{
  "_source": "format-token",
  "_note": "How an institution writes an indicator name it means: the expression layer read by mirobody_gen/surface.py. Every choice carries a provenance tier. Shares and rates of `observed` choices are written by scripts/distill_surface.py from aggregate counts over the reference set; every other entry is hand-authored and names its source.",
  "_provenance": {
    "script": "scripts/distill_surface.py",
    "method": "Chinese reference documents' printed row names; a join counts only when both halves are catalogue vocabulary, so join shares undercount and are small-sample (n per form below). Suffix/marker rates: document rate, and rows marked within the documents that mark any.",
    "panels": "hand-authored: the laboratory panels whose items an LIS dictionary appends an assay word or send-out marker to",
    "measured": {
      "reference_documents": 347,
      "name_join_documents": {
        "abbr_first": 2,
        "glued": 6,
        "paren": 9,
        "spaced": 2
      },
      "name_suffix_documents": 16,
      "name_marker_documents": 3,
      "sig_word_documents": {
        "": 3,
        "一日": 1,
        "一次": 1,
        "每天": 1,
        "每日": 1,
        "每次": 2
      }
    }
  },
  "_vocabulary_fields": [
    "word"
  ],
  "tiers": {
    "observed": "an aggregate rate distilled from the reference set",
    "reference": "a published standard, terminology or vendor specification",
    "field": "a downstream consumer's bug report, not yet seen in the reference set",
